{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/portal",
      "destination": "/portal/courses",
      "permanent": false
    },
    {
      "source": "/portal/",
      "destination": "/portal/courses",
      "permanent": false
    },
    {
      "source": "/portal/index.html",
      "destination": "/portal/courses",
      "permanent": false
    },
    {
      "source": "/portal/lessons",
      "destination": "/portal/courses",
      "permanent": false
    },
    {
      "source": "/portal/lessons.html",
      "destination": "/portal/courses",
      "permanent": false
    },
    {
      "source": "/portal/tests",
      "destination": "/portal/courses",
      "permanent": false
    },
    {
      "source": "/portal/tests.html",
      "destination": "/portal/courses",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
