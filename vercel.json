{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/join/:token",
      "destination": "/join"
    },
    {
      "source": "/setup/:token",
      "destination": "/set-password"
    }
  ],
  "redirects": [
    {
      "source": "/pricing",
      "destination": "/contact",
      "permanent": false
    },
    {
      "source": "/pricing.html",
      "destination": "/contact",
      "permanent": false
    },
    {
      "source": "/portal",
      "destination": "/portal/courses",
      "permanent": false
    },
    {
      "source": "/portal/",
      "destination": "/portal/courses",
      "permanent": false
    },
    {
      "source": "/portal/index.html",
      "destination": "/portal/courses",
      "permanent": false
    },
    {
      "source": "/portal/lessons",
      "destination": "/portal/courses",
      "permanent": false
    },
    {
      "source": "/portal/lessons.html",
      "destination": "/portal/courses",
      "permanent": false
    },
    {
      "source": "/portal/tests",
      "destination": "/portal/courses",
      "permanent": false
    },
    {
      "source": "/portal/tests.html",
      "destination": "/portal/courses",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/download/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"lumen.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
